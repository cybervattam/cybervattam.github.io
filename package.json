{
  "name": "Cybervattam-web",
  "version": "1.0.0",
  "description": "Cybervattam Web Portal",
  "author": "Venkatesh Jambulingam",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/techatpark/npm_scripts_static-ref.git"
  },
  "keywords": [
    "npm",
    "scripts",
    "npm scripts",
    "watch",
    "minify",
    "compress"
  ],
  "bugs": {
    "url": "https://github.com/techatpark/npm_scripts_static-ref/issues"
  },
  "homepage": "https://github.com/techatpark/npm_scripts_static-ref#readme",
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-eslint": "9.2.0",
    "@rollup/plugin-multi-entry": "7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "autoprefixer": "10.6.1",
    "bootstrap": "5.3.8",
    "copy-files-from-to": "4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "hugo-bin": "^0.163.0",
    "npm-run-all": "4.1.5",
    "onchange": "7.1.0",
    "postcss": "8.5.28",
    "postcss-cli": "12.0.0",
    "postcss-nested": "8.0.1",
    "prettier": "3.9.8",
    "rimraf": "6.1.3",
    "rollup": "4.63.4",
    "sass": "1.104.1",
    "webpack": "5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "serve": "webpack serve",
    "format:js": "prettier --write src/js",
    "build:hugo": "hugo --minify -d ../dist -s site",
    "build:sass": "sass --silence-deprecation=import --silence-deprecation=if-function --silence-deprecation=global-builtin --silence-deprecation=color-functions src/scss:dist/css",
    "build:css": "postcss src/css --dir dist/css",
    "build:js": "rollup -c",
    "build": "run-s clean format:js build:*",
    "watch:hugo": "onchange \"site\" -- run-s build:hugo",
    "watch:sass": "onchange \"src/scss\" -- run-s build:sass",
    "watch:css": "onchange \"src/css\" -- run-s build:css",
    "watch:js": "onchange \"src/js\" -- run-s format:js build:js",
    "start": "npm run build && run-p serve watch:*",
    "postinstall": "npm run build"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "easymde": "2.21.0",
    "marked": "18.0.13",
    "qrious": "^4.0.2",
    "replace-in-file": "9.0.0"
  }
}
