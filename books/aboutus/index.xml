<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>About Us on Cybervattam</title><link>/books/aboutus/</link><description>Recent content in About Us on Cybervattam</description><generator>Hugo</generator><language>en</language><lastBuildDate>Wed, 14 Nov 2018 19:02:50 -0700</lastBuildDate><atom:link href="/books/aboutus/index.xml" rel="self" type="application/rss+xml"/><item><title>About Us</title><link>/books/aboutus/aboutus/aboutus/</link><pubDate>Wed, 14 Nov 2018 19:02:50 -0700</pubDate><guid>/books/aboutus/aboutus/aboutus/</guid><description>&lt;a href="/books/aboutus/aboutus/aboutus/#about-us"&gt;&#10;&lt;h3 id="about-us"&gt;&#10; About us &#10;&lt;/h3&gt;&#10;&lt;/a&gt;&lt;p&gt;Hello&amp;hellip;!!! Welcome to Cybervattam&amp;hellip;!!!&lt;/p&gt;&#10;&lt;p&gt;The purpose of this site is to create/share the technical knowledge content in Indian languages to facilitate learning technology in your respective native Indian language.&lt;/p&gt;&#10;&lt;p&gt;Currently, content is available in English, Tamil, Malayalam, Telugu, Kannada &amp;amp; Hindi. We are very interested in making it available in other languages ​​as well.&lt;/p&gt;&#10;&lt;p&gt;Content is primarly created in English &amp;amp; translated to other languages using AI tools. AI may make mistakes in translation. Please help us correct it if you find any.&lt;/p&gt;</description></item><item><title>Contributors</title><link>/books/aboutus/contribution/contribution/</link><pubDate>Wed, 14 Nov 2018 19:02:50 -0700</pubDate><guid>/books/aboutus/contribution/contribution/</guid><description>&lt;table&gt;&#10;&#9;&lt;thead&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;Topic&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;Published Date&lt;/th&gt;&#10;&#9;&#9;&#9;&#9;&#9;&lt;th&gt;Author/Contributor&lt;/th&gt;&#10;&#9;&#9;&#9;&lt;/tr&gt;&#10;&#9;&lt;/thead&gt;&#10;&#9;&lt;tbody&gt;&#10;&#9;&#9;&#9;&lt;tr&gt;&#10;&#9;